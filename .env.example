# MediaIQ environment template.
# Copy this file to .env.local and replace every placeholder.
# .env.local is ignored by Git. Do not put real values in this file.

# Public. These values are visible to the browser.
# Local Supabase prints them from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.example
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Absolute site origin used in authentication email links.
# Local development may use http://127.0.0.1:3000 or http://localhost:3000.
# A deployed environment requires HTTPS and no path, query, or credentials.
# Leave this unset for local development to keep the localhost origin.
SITE_URL=

# Server-only. Direct Postgres connection for the authentication audit writer.
# This is not the public Supabase URL.
MEDIAIQ_SECURITY_DATABASE_URL=postgres://security-writer:replace-with-local-password@127.0.0.1:54322/postgres

# Server-only. Hex-encoded signing key and its numeric key id.
MEDIAIQ_AUDIT_SIGNING_KEY=replace-with-a-random-hex-key
MEDIAIQ_AUDIT_SIGNING_KEY_ID=1

# Server-only. Random secret used to hash rate-limit subjects.
MEDIAIQ_RATE_LIMIT_PEPPER=replace-with-a-random-string

# Server-only. Direct Postgres connection for campaign evidence and MIA.
# The application refuses this connection when NODE_ENV is production,
# and when VERCEL_ENV is production or preview.
MEDIAIQ_EVIDENCE_DATABASE_URL=postgres://evidence-writer:replace-with-local-password@127.0.0.1:54322/postgres

# Server-only. Provider credential for MIA. There is no second provider.
MEDIAIQ_OPENAI_API_KEY=replace-with-your-provider-key
